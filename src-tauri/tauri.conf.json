{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lilt",
  "version": "0.3.0",
  "identifier": "com.lilt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lilt",
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#f5f3ed",
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/nsis/header.bmp",
        "sidebarImage": "installer/nsis/sidebar.bmp",
        "installerIcon": "installer/nsis/lilt.ico",
        "uninstallerIcon": "installer/nsis/lilt.ico"
      }
    }
  }
}
