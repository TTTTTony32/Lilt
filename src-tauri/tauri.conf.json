{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lilt",
  "version": "0.6.5",
  "identifier": "com.lilt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lilt",
        "width": 1200,
        "height": 820,
        "center": true,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#f5f3ed",
        "visible": false,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/nsis/header.bmp",
        "sidebarImage": "installer/nsis/sidebar.bmp",
        "installerIcon": "installer/nsis/lilt.ico",
        "uninstallerIcon": "installer/nsis/lilt.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzOEIwQTA5MTRGRDk5M0QKUldROW1mMFVDUXFMZ3c3Nk11V3Qrbm1Mc1B2Q0g3bytkUzRZMVNHbUlYVWpZblpWNk13bjQ4Z1QK",
      "endpoints": [
        "https://github.com/TTTTTony32/Lilt/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
